<% layout("/layouts/boilerplate") -%>

<main class="booking-page">
  <a class="booking-back-link" href="/listings/<%= listing._id %>">
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to stay
  </a>
  <div class="booking-layout">
    <section class="booking-form-card">
      <p class="eyebrow">Plan your getaway</p>
      <h1>Request to book</h1>
      <p class="booking-form-intro">Choose your dates. The host will review your request before you pay.</p>
      <form action="/listings/<%= listing._id %>/book" method="POST" class="booking-date-form">
        <div class="booking-date-grid">
          <div>
            <label class="form-label" for="checkIn">Check-in</label>
            <input
              class="form-control"
              type="date"
              id="checkIn"
              name="booking[checkIn]"
              min="<%= new Date().toISOString().slice(0, 10) %>"
              required
            />
          </div>
          <div>
            <label class="form-label" for="checkOut">Check-out</label>
            <input
              class="form-control"
              type="date"
              id="checkOut"
              name="booking[checkOut]"
              min="<%= new Date().toISOString().slice(0, 10) %>"
              required
            />
          </div>
        </div>
        <p class="booking-secure-note">
          <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
          You’ll only pay after the host approves your request.
        </p>
        <button class="btn booking-cta-button w-100" type="submit">
          Send booking request <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </button>
      </form>
    </section>

    <aside class="booking-stay-card">
      <img src="<%= listing.image?.url || 'https://placehold.co/800x600?text=Stay' %>" alt="<%= listing.title %>" />
      <div class="booking-stay-details">
        <p class="eyebrow mb-2"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> <%= listing.location %>, <%= listing.country %></p>
        <h2><%= listing.title %></h2>
        <p><%= listing.description %></p>
        <p class="booking-stay-price"><strong>&#8377;<%= listing.price.toLocaleString("en-IN") %></strong> / night</p>
      </div>
    </aside>
  </div>
</main>

<script>
  const checkInInput = document.getElementById("checkIn");
  const checkOutInput = document.getElementById("checkOut");
  checkInInput.addEventListener("change", () => {
    const checkIn = new Date(`${checkInInput.value}T00:00:00`);
    if (Number.isNaN(checkIn.getTime())) {
      return;
    }

    checkIn.setDate(checkIn.getDate() + 1);
    const earliestCheckOut = [
      checkIn.getFullYear(),
      String(checkIn.getMonth() + 1).padStart(2, "0"),
      String(checkIn.getDate()).padStart(2, "0"),
    ].join("-");
    checkOutInput.min = earliestCheckOut;
    if (!checkOutInput.value || checkOutInput.value < earliestCheckOut) {
      checkOutInput.value = earliestCheckOut;
    }
  });
</script>
