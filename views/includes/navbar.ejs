<nav class="navbar navbar-expand-md border-bottom sticky-top">
  <div class="container-fluid navbar-container">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <i class="fa-regular fa-compass" aria-hidden="true"></i>
      <span class="brand-name">Yatra-Nest</span>
    </a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
      aria-controls="navbarNav"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <div class="navbar-nav">
        <a class="nav-link" href="/#about">About</a>
        <a class="nav-link" href="/listings"><b>Explore stays</b></a>
      </div>
      <form class="nav-search" role="search" action="/listings" method="GET">
        <i class="fa-solid fa-location-dot nav-search-icon" aria-hidden="true"></i>
        <input
          class="form-control search-inp"
          name="search"
          type="search"
          value="<%= searchQuery || '' %>"
          placeholder="City, stay or country"
          aria-label="Search by city, stay or country"
        />
        <button class="btn btn-search" type="submit">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <span>Search</span>
        </button>
      </form>
      <div class="navbar-nav navbar-actions align-items-xl-center">
        <a class="nav-link host-link" href="/listings/new">
          <i class="fa-solid fa-plus" aria-hidden="true"></i> Host a stay
        </a>
        <% if (!currUser) { %>
          <a class="nav-link" href="/signup"><b>Sign Up</b></a>
          <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } else { %>
          <span class="nav-link user-name">@<%= currUser.username %></span>
          <form action="/logout" method="POST">
            <button class="nav-link btn btn-link text-decoration-none"><b>Log out</b></button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</nav>
