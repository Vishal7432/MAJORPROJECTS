<% layout("/layouts/boilerplate") -%>

<main class="listings-page">
  <section class="listings-hero mb-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-3">
      <div>
        <p class="eyebrow mb-2">Make room for a little wonder</p>
        <h1 class="page-title mb-2">
          <%= searchQuery ? "Your search starts here" : "Find a stay that feels like yours" %>
        </h1>
        <p class="listings-intro mb-0">
          <%= searchQuery ? "Explore places matching your destination." : "Thoughtful stays for the stories you haven't made yet." %>
        </p>
      </div>
      <div class="listings-summary">
        <span class="listings-count"><%= allListings.length %></span>
        <span><%= allListings.length === 1 ? "stay to explore" : "stays to explore" %></span>
      </div>
    </div>
  </section>

  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <% if (searchQuery) { %>
      <p class="search-summary mb-0">Showing results for <strong>“<%= searchQuery %>”</strong></p>
    <% } else { %>
      <p class="search-summary mb-0">Handpicked places for your next escape</p>
    <% } %>
    <div class="tax-toggle">
      <div class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox" id="tax-toggle" />
        <label class="form-check-label" for="tax-toggle">Show estimated 18% tax</label>
      </div>
    </div>
  </div>

  <% if (allListings.length === 0) { %>
    <div class="empty-state text-center py-5">
      <span class="empty-state-icon" aria-hidden="true"><i class="fa-regular fa-compass"></i></span>
      <h2 class="h4">No stays found</h2>
      <p class="text-secondary">Try another destination or browse all available stays.</p>
      <a class="btn btn-outline-dark" href="/listings">Browse all stays</a>
    </div>
  <% } else { %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
      <% for (const listing of allListings) { %>
        <div class="col">
          <a href="/listings/<%= listing.id %>" class="listing-link">
            <article class="card listing-card h-100">
              <img
                src="<%= listing.image?.url || 'https://placehold.co/800x600?text=Stay' %>"
                class="card-img-top listing-card-image"
                alt="<%= listing.title %>"
                loading="lazy"
                decoding="async"
              />
              <div class="card-body">
                <h2 class="card-title"><%= listing.title %></h2>
                <p class="listing-location">
                  <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                  <%= listing.location %>, <%= listing.country %>
                </p>
                <div class="listing-price">
                  <p class="card-text mb-0">
                    <strong>&#8377;<%= listing.price.toLocaleString("en-IN") %></strong><span class="price-unit"> / night</span>
                  </p>
                  <span class="tax-info">+ &#8377;<%= Math.round(listing.price * 0.18).toLocaleString("en-IN") %> est. tax</span>
                </div>
              </div>
            </article>
          </a>
        </div>
      <% } %>
    </div>
  <% } %>
</main>

<script>
  // Keep the tax hint hidden until a visitor explicitly enables it.
  document.getElementById("tax-toggle").addEventListener("change", (event) => {
    document.querySelectorAll(".tax-info").forEach((item) => {
      item.classList.toggle("is-visible", event.target.checked);
    });
  });
</script>
