<% layout("/layouts/boilerplate") -%>

<script>
  const mapToken = <%- JSON.stringify(mapToken) %>;
  // Escape HTML delimiters before embedding database content in a script block.
  const listing = <%- JSON.stringify({
    title: listing.title,
    geometry: listing.geometry
  }).replace(/</g, "\\u003c") %>;
</script>

<main class="row g-4 py-4">
  <div class="col-12 col-lg-8 offset-lg-2">
    <h1 class="page-title h2"><%= listing.title %></h1>
    <article class="card show-card listing-card">
      <img
        src="<%= listing.image?.url || 'https://placehold.co/1200x800?text=Stay' %>"
        class="card-img-top show-img"
        alt="<%= listing.title %>"
      />
      <div class="card-body">
        <p class="card-text">
          Hosted by <strong><%= listing.owner?.username || "Unknown" %></strong>
        </p>
        <p><%= listing.description %></p>
        <p><strong>&#8377;<%= listing.price.toLocaleString("en-IN") %></strong> / night</p>
        <p><%= listing.location %>, <%= listing.country %></p>
      </div>
    </article>
  </div>

  <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
    <div class="col-12 col-lg-8 offset-lg-2">
      <div class="btns">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">Edit listing</a>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
          <button class="btn btn-outline-danger" type="submit">Delete listing</button>
        </form>
      </div>
    </div>
  <% } %>

  <section class="col-12 col-lg-8 offset-lg-2 mb-3">
    <% if (currUser) { %>
      <hr />
      <h2 class="h4">Leave a review</h2>
      <form
        action="/listings/<%= listing.id %>/reviews"
        method="POST"
        novalidate
        class="needs-validation"
      >
        <div class="mb-3">
          <label for="rating" class="form-label">Rating</label>
          <fieldset id="rating" class="starability-slot">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>
        <div class="mb-3">
          <label for="comment" class="form-label">Comment</label>
          <textarea
            name="review[comment]"
            id="comment"
            rows="5"
            class="form-control"
            required
          ></textarea>
          <div class="invalid-feedback">Please add a comment for your review.</div>
        </div>
        <button class="btn btn-outline-dark" type="submit">Submit review</button>
      </form>
      <hr />
    <% } %>

    <% if (listing.reviews.length > 0) { %>
      <h2 class="h4 mb-3">Reviews</h2>
      <div class="row row-cols-1 row-cols-md-2 g-3">
        <% for (const review of listing.reviews) { %>
          <div class="col">
            <article class="card h-100">
              <div class="card-body">
                <h3 class="card-title h6">@<%= review.author?.username || "Former user" %></h3>
                <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                <p class="card-text"><%= review.comment %></p>
              </div>
              <% if (currUser && review.author && currUser._id.equals(review.author._id)) { %>
                <form
                  class="card-footer bg-transparent border-0"
                  action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                  method="POST"
                >
                  <button class="btn btn-sm btn-outline-danger" type="submit">Delete review</button>
                </form>
              <% } %>
            </article>
          </div>
        <% } %>
      </div>
    <% } %>
  </section>

  <section class="col-12 col-lg-8 offset-lg-2 mb-4">
    <h2 class="h4">Where you'll be</h2>
    <div id="map" class="mt-3" role="img" aria-label="Map showing the listing location"></div>
  </section>
</main>

<script src="/Js/map.js"></script>
