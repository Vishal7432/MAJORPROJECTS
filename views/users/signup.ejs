<% layout("/layouts/boilerplate") %>

<main class="auth-page">
  <section class="auth-card">
    <p class="eyebrow">Start your next story</p>
    <h1>Join Yatra-Nest</h1>
    <p class="auth-description">Create an account to share and discover special stays.</p>
    <form action="/signup" method="POST" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input
          name="username"
          type="text"
          class="form-control"
          id="username"
          required
        />
        <div class="valid-feedback">Looks good!</div>
      </div>
      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input
          name="email"
          type="email"
          class="form-control"
          id="email"
          required
        />
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input
          name="password"
          type="password"
          class="form-control"
          id="password"
          required
        />
      </div>
      <button class="btn btn-search auth-submit" type="submit">Create account</button>
    </form>
    <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
  </section>
</main>
