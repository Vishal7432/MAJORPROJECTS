<% layout("/layouts/boilerplate") %>

<main class="auth-page">
  <section class="auth-card">
    <p class="eyebrow">Welcome back</p>
    <h1>Log in to Yatra-Nest</h1>
    <p class="auth-description">Pick up where your next getaway begins.</p>
    <form action="/login" method="POST" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input
          name="username"
          type="text"
          class="form-control"
          id="username"
          required
        />
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input
          name="password"
          type="password"
          class="form-control"
          id="password"
          required
        />
      </div>
      <button class="btn btn-search auth-submit" type="submit">Log in</button>
    </form>
    <p class="auth-switch">New to Yatra-Nest? <a href="/signup">Create an account</a></p>
  </section>
</main>
